# =============================================================
# Variables de entorno que lee frontend/src/app.py
# Para infra: las no-sensibles van en ConfigMap, las sensibles
# (marcadas SECRET) en el Secret "sqlserver-secret".
# =============================================================

SECRET_KEY=cambiar-en-produccion          # SECRET (firma de sesion Flask)

# --- SQL Server (Service: ubicacion-db) ---
SQL_HOST=ubicacion-db
SQL_PORT=1433
SQL_USER=sa                                # SECRET
SQL_PASSWORD=TuPasswordFuerte123           # SECRET
SQL_DATABASE=Inventario

# --- MongoDB (Service: inventario-db) ---
MONGO_HOST=inventario-db
MONGO_PORT=27017
MONGO_DB=inventario
MONGO_COLLECTION=hardware
MONGO_USER=                                # SECRET (vacio si Mongo sin auth)
MONGO_PASSWORD=                            # SECRET

# --- LDAP / Active Directory (Service: ldap-service) ---
LDAP_HOST=ldap-service
LDAP_PORT=389
LDAP_DOMAIN=itu.local
